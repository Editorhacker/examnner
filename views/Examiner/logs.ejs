<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Room Logs - <%= roomId %></title>
  <link
    href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
      word-wrap: break-word;
    }

    th {
      background-color: #f2f2f2;
    }

    /* Better scroll handling */
    tbody {
      max-height: 400px;
      overflow-y: auto;
      display: block;
    }

    tr {
      display: table;
      width: 100%;
      table-layout: fixed;
    }

    .container {
      margin-top: 30px;
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <%- include("../includes/nav.ejs") %>

  <div class="container">
    <a href="javascript:history.back()" class="btn btn-primary mb-4">&lt; Back</a>

    <h1 class="text-center mb-4">Logs for Room: <%= roomId %></h1>

    <div class="table-responsive">
      <table class="table table-bordered table-striped">
        <thead class="thead-dark">
          <tr>
            <th>Roll Number</th>
            <th>Message</th>
            <th>Status</th>
            <th>Timestamp</th>
          </tr>
        </thead>
        <tbody id="logs-table-body">
          <% logs.forEach(log => { %>
            <tr>
              <td><%= log.rollNumber %></td>
              <td><%= log.message %></td>
              <td><%= log.status %></td>
              <td><%= new Date(log.timestamp).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

  <script>
    const roomId = "<%= roomId %>";
    const tableBody = document.getElementById("logs-table-body");

    // ✅ Use relative path so it works in all environments
    const eventSource = new EventSource(`/createClass/logs/${roomId}/stream`);

    eventSource.onmessage = (event) => {
      try {
        const log = JSON.parse(event.data);

        const row = document.createElement("tr");
        row.innerHTML = `
          <td>${log.rollNumber || "—"}</td>
          <td>${log.message || "No message"}</td>
          <td>${log.status || "N/A"}</td>
          <td>${new Date().toLocaleString("en-IN", { timeZone: "Asia/Kolkata" })}</td>
        `;

        // Add new log on top
        tableBody.prepend(row);
        tableBody.scrollTop = 0;
      } catch (err) {
        console.error("Invalid log data:", err, event.data);
      }
    };

    eventSource.onerror = (err) => {
      console.error("Error connecting to the server for live logs:", err);
      eventSource.close();
      alert("⚠️ Lost connection to the server. Logs may not update in real-time.");
    };
  </script>
</body>
</html>
